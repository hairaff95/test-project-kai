APP_NAME="Sistem Informasi Aset KAI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE
# =============================================================================
# Pilih salah satu konfigurasi di bawah sesuai environment kamu.

# --- LOCAL (Laragon / XAMPP) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kai_tracker
DB_USERNAME=root
DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=   # Kosongkan untuk lokal — tidak butuh SSL

# --- PRODUCTION (TiDB Cloud / Remote MySQL dengan SSL) ---
# DB_CONNECTION=mysql
# DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=kai_tracker
# DB_USERNAME=your_username
# DB_PASSWORD=your_password
# MYSQL_ATTR_SSL_CA=isrgrootx1.pem
# DB_READ_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# DB_WRITE_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com

# =============================================================================
# SESSION & CACHE
# =============================================================================
# --- LOCAL ---
SESSION_DRIVER=file
CACHE_STORE=file

# --- PRODUCTION (Redis) ---
# SESSION_DRIVER=redis
# CACHE_STORE=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================================
# QUEUE
# =============================================================================
# --- LOCAL ---
QUEUE_CONNECTION=sync

# --- PRODUCTION ---
# QUEUE_CONNECTION=redis

# =============================================================================
# REDIS (hanya untuk production)
# =============================================================================
# REDIS_CLIENT=predis
# REDIS_SCHEME=tls
# REDIS_HOST=host-redis
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=null

# =============================================================================
# MAIL
# =============================================================================
# Untuk lokal: gunakan 'log' agar OTP tampil di halaman tanpa kirim email sungguhan
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@kai.id"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# BROADCAST & FILESYSTEM
# =============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# =============================================================================
# AWS (opsional)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
